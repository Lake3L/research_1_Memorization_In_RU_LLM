.gitignore
# local working materials (not part of the public record)
papers/
external/
notes/
scratch/

# python
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# secrets & local config
.env
*.key
api-secretkey-openai.txt

# notes
a_notes.md

# experiment outputs (committed selectively via results/)
outputs/
wandb/

# dataset payloads: registry.json carries provenance and hashes, files are refetched by scripts
data/*/variants/
data/*/*.csv

# AI working notes (not part of the research record)
AI/
